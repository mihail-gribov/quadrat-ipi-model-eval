# Keys are read from the environment first, then from this file (copy to .env; it is
# git-ignored). A model config names the variable (`api_key_env`), never the value.
OPENAI_API_KEY=
NEBIUS_API_KEY=
GOOGLE_API_KEY=
MISTRAL_API_KEY=
ANTHROPIC_API_KEY=
# For a local OpenAI-compatible server (models/local-vllm.toml); any value if it checks none.
LOCAL_API_KEY=
